# ================================================================
#  Smart Chashi — Environment Variables
#  Copy this to .env for local dev.
#  On Railway: set these in the Railway dashboard (Variables tab).
#  Railway MySQL plugin auto-fills the MYSQL* vars.
# ================================================================

# ── Database (Railway MySQL plugin sets these automatically) ─────
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLDATABASE=smartcashi_db
MYSQLUSER=root
MYSQLPASSWORD=

# ── AI / External APIs ───────────────────────────────────────────
GROQ_API_KEY=

# ── Email (Gmail App Password) ───────────────────────────────────
SMTP_USERNAME=
SMTP_PASSWORD=
